{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "earnings",
        "guidance",
        "analyst_action",
        "merger_acquisition",
        "regulatory",
        "legal",
        "product",
        "management",
        "capital_return",
        "partnership_contract",
        "macro_sector",
        "other"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "positive",
        "negative",
        "neutral"
      ]
    },
    "horizon": {
      "type": "string",
      "enum": [
        "short_term",
        "medium_term",
        "long_term"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "article_id",
    "ticker",
    "event_type",
    "direction",
    "horizon",
    "confidence"
  ],
  "additionalProperties": false
}
